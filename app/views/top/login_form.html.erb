
<h1>ログイン</h1>

<% if flash[:alert] %>
  <p><%= flash[:alert] %></p>
<% end %>

<%= form_with url: top_login_path, method: :post do |f| %>
  <p>
    <%= f.label :uid, "ユーザID" %>
    <%= f.text_field :uid %>
  </p>

  <p>
    <%= f.label :password, "パスワード" %>
    <%= f.password_field :password %>
  </p>

  <%= f.submit "ログイン" %>
<% end %>

<p><%= link_to "新規ユーザ登録", new_user_path %></p>
<p><%= link_to "ツイート一覧に戻る", tweets_path %></p>
